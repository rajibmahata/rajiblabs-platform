# ═══════════════════════════════════════════════════════════════════
# RajibLabs — PRODUCTION environment template (FastAPI + MongoDB)
# ─────────────────────────────────────────────────────────────────
# ⚠️  PLACEHOLDERS ONLY — this file is safe to commit because it contains
#     NO real secrets. On the server, either:
#       cp .env.production .env   (then fill the <...> values), or
#       paste each value into your hosting provider's env-var panel
#       (SmarterASP / VPS / Docker), which takes precedence.
# Full reference for every value: ../../docs/configuration.md
# ═══════════════════════════════════════════════════════════════════

# ── App core ──
APP_ENV=production
APP_URL=https://rajiblabs.com
BASE_URL=https://rajiblabs.com
CORS_ORIGINS=https://rajiblabs.com
APP_TIMEZONE=Asia/Kolkata
SECRET_KEY=

# ── Database (MongoDB) ──
# Docker Compose: mongodb://mongo:27017/rajiblabs
# Atlas example:  mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/rajiblabs
DATABASE_URL=mongodb://mongo:27017/rajiblabs
MONGO_DB_NAME=rajiblabs

# ── Admin auth (dual-email, one identity; seeded once, never overwritten) ──
ADMIN_EMAILS=rajibmahata143@gmail.com,rajibmahata143@outlook.com
ADMIN_INITIAL_PASSWORD=
JWT_SECRET=
JWT_EXPIRE_MINUTES=15
REFRESH_EXPIRE_DAYS=7
API_KEY=
JWT_ISSUER=rajiblabs

# ── OpenAI: cheapest setup (gpt-5-nano primary, gpt-5.6-luna fallback) ──
# Key: https://platform.openai.com/api-keys  (~$5 covers thousands of chats/jobs)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_FALLBACK_MODEL=gpt-5.6-luna
OPENAI_ENABLED=true
OPENAI_MAX_RETRIES=3
AI_AUTO_PUBLISH=false
AI_QUALITY_THRESHOLD=85

# ── GitHub sync (read-only token, least privilege) ──
# Token: GitHub → Settings → Developer settings → Personal access tokens
# Classic scope: public_repo · or fine-grained: read-only contents/metadata
GITHUB_OWNER=rajibmahata
GITHUB_TOKEN=
GITHUB_SYNC_ENABLED=true
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rajiblabs_knowledge
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_VERSION=v1
EMBEDDING_DIM=1536
RAG_ENABLED=true
RAG_TOP_K=5
RAG_MIN_SCORE=0.35
RAG_CACHE_TTL_SECONDS=3600
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
GITHUB_RAG_REPOS=
GITHUB_RAG_MAX_FILES=40
GITHUB_RAG_MAX_BYTES=200000

# ── Agent / chat / QA ──
DAILY_AGENT_ENABLED=true
DAILY_AGENT_HOUR=2
DAILY_AGENT_MINUTE=0
CHAT_ENABLED=true
LOG_RETENTION_DAYS=5

# ── Uploads & resume ──
UPLOAD_DIR=./data/uploads
MAX_IMAGE_MB=5
MAX_RESUME_MB=10
RESUME_PATH=

# ── Contact (mirrors frontend/src/config/site.ts) ──
CONTACT_EMAIL=rajibmahata143@gmail.com
CONTACT_EMAIL_SECONDARY=rajibmahata143@outlook.com
PRIMARY_PHONE=+918420249020
SECONDARY_PHONE=+919100184730
WHATSAPP_PHONE=+918420249020

# ── SMTP (optional; empty = dashboard-only notifications) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
