# RajibLabs MCP Server — Environment Variables
# Copy to .env and fill in values

# App
MCP_APP_ENV=development
MCP_DEBUG=false

# MongoDB
MCP_DATABASE_URL=mongodb://localhost:27017/rajiblabs
MCP_MONGO_DB_NAME=rajiblabs

# Qdrant
MCP_QDRANT_URL=http://localhost:6333

# Redis
MCP_REDIS_URL=redis://localhost:6379/0

# GitHub
MCP_GITHUB_OWNER=rajibmahata
MCP_GITHUB_TOKEN=

# OpenAI
MCP_OPENAI_API_KEY=
MCP_OPENAI_MODEL=gpt-4o-mini

# MCP Server
MCP_MCP_HOST=0.0.0.0
MCP_MCP_PORT=8100
MCP_MCP_TRANSPORT=sse

# Auth
MCP_MCP_API_KEY=
MCP_ADMIN_API_KEY=

# Logging
MCP_LOG_LEVEL=INFO
MCP_ENABLE_AUDIT_LOG=true
MCP_ENABLE_TOOL_METRICS=true

# Cache
MCP_CACHE_ENABLED=true
MCP_CACHE_TTL_SECONDS=300
