# MCP Server Environment Variables
# Copy to .env and configure

# App
MCP_APP_ENV=development
MCP_DEBUG=false

# Database (same as ai-api)
MCP_DATABASE_URL=mongodb://localhost:27017/rajiblabs
MCP_MONGO_DB_NAME=rajiblabs

# Qdrant
MCP_QDRANT_URL=http://localhost:6333

# GitHub
MCP_GITHUB_OWNER=rajib-mahata
MCP_GITHUB_TOKEN=

# AI (for content refinement)
MCP_OPENAI_API_KEY=
MCP_OPENAI_MODEL=gpt-4o-mini

# MCP Server
MCP_MCP_HOST=0.0.0.0
MCP_MCP_PORT=8100

# Auth (empty = dev mode allows all)
MCP_MCP_API_KEY=
MCP_ADMIN_API_KEY=

# Logging
MCP_LOG_LEVEL=INFO

# Observability
MCP_ENABLE_AUDIT_LOG=true
MCP_ENABLE_TOOL_METRICS=true
